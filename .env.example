# Environment variables for the API.
# Copy this file to `.env` in the repository root and fill in your values.
# (Both the root `.env` and `backend/.env` are supported.)

# Full MongoDB connection string
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/todos?retryWrites=true&w=majority"

# Optional: port the API listens on (defaults to 5000)
# PORT=5000
